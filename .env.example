# Auth.js session secret. Generate: `openssl rand -base64 32`
# TODO(firebase-migration): superseded by Firebase Auth session cookies —
# remove once the NextAuth cutover (Phase 4) lands.
AUTH_SECRET=****

# --- Firebase Auth ---

# Client SDK config (from Firebase console: Project Settings > General > Your
# apps > Web app). Not secret — safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=****
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=****
NEXT_PUBLIC_FIREBASE_PROJECT_ID=****
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=****
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=****
NEXT_PUBLIC_FIREBASE_APP_ID=****

# Admin SDK (server-only, secret). From a generated service account key:
# Project Settings > Service Accounts > Generate new private key.
#
# Easiest: paste the ENTIRE downloaded JSON ({...}) as one value here and
# leave the three FIREBASE_* vars below unset — avoids private-key newline
# mangling completely.
FIREBASE_SERVICE_ACCOUNT_KEY=****
#
# Or the three discrete vars. FIREBASE_PRIVATE_KEY must be the PEM with
# newlines as literal \n (or real newlines), NO surrounding quotes.
# Local dev: leave all of the above unset and set
# GOOGLE_APPLICATION_CREDENTIALS to the downloaded JSON file's path instead.
FIREBASE_PROJECT_ID=****
FIREBASE_CLIENT_EMAIL=****
FIREBASE_PRIVATE_KEY=****

# Comma-separated emails that get isAdmin=true on first Firebase sign-in
# (re-synced on every login). Must include the app owner's email.
ADMIN_EMAILS=hexthechmeka@gmail.com

# BYOK — encrypts each user's stored Anthropic/GLM/GitHub PAT keys
# (UserCredential table) and the RunPod control key (RunpodSetting.apiKey)
# at rest. 32 bytes, base64. Generate: `openssl rand -base64 32`. Losing
# this key makes every stored credential unrecoverable — back it up.
CREDENTIALS_ENCRYPTION_KEY=****

# Anthropic Claude — called directly (not via AI Gateway)
ANTHROPIC_API_KEY=****

# GLM / Zhipu (BigModel) — called directly
GLM_API_KEY=****

# Postgres (Neon). Use the pooled connection string for serverless.
POSTGRES_URL=****

# --- optional ---

# Vercel Blob store token. Local dev only needs this if you upload images.
# On Vercel the connected store injects Agentie_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=****

# Redis — IP rate limiting (production only). Safe to omit in dev.
REDIS_URL=****

# The account that server-to-server calls (Vultr dev-agent usage
# logging/limit checks — no user session in that context) attribute usage
# to. Should match the email you sign in with via Firebase. Defaults to
# owner@agentwork.local.
OWNER_EMAIL=owner@agentwork.local

# Set to require a shared password before the app loads (dormant if unset).
ACCESS_PASSWORD=

# AIchat — OpenAI-compatible endpoint for persona/roleplay chat.
# Build-phase backend (RunPod); swap via lib/ai/aichat-provider.ts.
RUNPOD_AICHAT_BASE_URL=
RUNPOD_AICHAT_API_KEY=

# Imagie (image generation). The RunPod pod id + account API key are entered
# in the app (설정 탭) and stored in the DB (RunpodSetting), not here.
# STORAGE_PROVIDER selects the MediaStorage backend; only "vercel-blob" (the
# default) is implemented. CRON_SECRET, if set, gates /api/imagie/cron/*.
STORAGE_PROVIDER=vercel-blob
CRON_SECRET=

# Imagie backend admin key (its ADMIN_API_KEY). Server-only — used by
# /api/imagie/admin/* to edit the pod's model catalog / add files. Never
# sent to the browser.
IMAGIE_ADMIN_KEY=

# Vultr dev-execution agent. The GLM code agent runs on the Vultr box;
# Vercel only forwards triggers + proxies the SSE progress stream.
VULTR_AGENT_SECRET=          # shared secret — identical value on Vultr's .env
VULTR_AGENT_URL=             # e.g. http://158.247.237.233:3001
