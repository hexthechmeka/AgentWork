# Auth.js session secret. Generate: `openssl rand -base64 32`
AUTH_SECRET=****

# Anthropic Claude — called directly (not via AI Gateway)
ANTHROPIC_API_KEY=****

# GLM / Zhipu (BigModel) — called directly
GLM_API_KEY=****

# Postgres (Neon). Use the pooled connection string for serverless.
POSTGRES_URL=****

# --- optional ---

# Vercel Blob store token. Local dev only needs this if you upload images.
# On Vercel the connected store injects Agentie_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=****

# Redis — IP rate limiting (production only). Safe to omit in dev.
REDIS_URL=****

# The single account every cookieless visit resolves to. Defaults to
# owner@agentwork.local. History is keyed to this account, so keep it stable.
OWNER_EMAIL=owner@agentwork.local

# Set to require a shared password before the app loads (dormant if unset).
ACCESS_PASSWORD=

# AIchat — OpenAI-compatible endpoint for persona/roleplay chat.
# Build-phase backend (RunPod); swap via lib/ai/aichat-provider.ts.
RUNPOD_AICHAT_BASE_URL=
RUNPOD_AICHAT_API_KEY=

# Imagie (image generation). The RunPod pod id + account API key are entered
# in the app (설정 탭) and stored in the DB (RunpodSetting), not here.
# STORAGE_PROVIDER selects the MediaStorage backend; only "vercel-blob" (the
# default) is implemented. CRON_SECRET, if set, gates /api/imagie/cron/*.
STORAGE_PROVIDER=vercel-blob
CRON_SECRET=
